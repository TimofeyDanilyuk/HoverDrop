<ui:FluentWindow x:Class="HoverDrop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:HoverDrop.App.ViewModels"
        Title="HoverDrop" Height="600" Width="490"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/HoverDrop.ico"
        WindowBackdropType="Mica">

    <ui:FluentWindow.DataContext>
        <vm:SettingsViewModel />
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="HoverDrop">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/HoverDrop.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,24">
                <TextBlock Text="{Binding SettingsHeader}" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

                <!-- Язык интерфейса -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="LocalLanguage24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding LanguageTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding LanguageHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                  SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Auto (System)"/>
                            <ComboBoxItem Content="Русский"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Тема -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="WeatherMoon24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ThemeTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ThemeHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Горячая клавиша -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Keyboard24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding HotkeyTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding HotkeyHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                SelectedIndex="{Binding TriggerIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Alt"/>
                            <ComboBoxItem Content="Ctrl"/>
                            <ComboBoxItem Content="Shift"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Размер меню -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ResizeLarge24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding MenuScaleTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding MenuScaleHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SizeSlider" Width="130" Minimum="70" Maximum="150"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding MenuScalePercent, Mode=TwoWay, Delay=300}"/>
                            <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                    Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}%}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Автозапуск -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AutostartTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding AutostartHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                        IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Звук -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Speaker224" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SoundTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding SoundHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                        IsChecked="{Binding PlaySound, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Подтверждение удаления -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Delete24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ConfirmDeleteTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ConfirmDeleteHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                        IsChecked="{Binding ConfirmDelete, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Обновления -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding UpdatesTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CardHint}"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center"
                                Content="{Binding UpdateButtonText}" Command="{Binding CheckUpdatesCommand}"/>
                    </Grid>
                </Border>

                <!-- Автопроверка обновлений -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="CloudArrowDown24" FontSize="22" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AutoUpdateTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding AutoUpdateHint}" Style="{StaticResource CardHint}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                        IsChecked="{Binding AutoUpdate, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <TextBlock Margin="2,8,2,0" Style="{StaticResource CardHint}"
                           Text="{Binding FooterHint}"/>

                <Button Content="{Binding ExitButton}" Command="{Binding ExitCommand}"
                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
