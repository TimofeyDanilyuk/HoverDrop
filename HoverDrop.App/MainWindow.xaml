<Window x:Class="HoverDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:HoverDrop.App.ViewModels"
        Title="HoverDrop Overlay" Height="400" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" DragEnter="Window_DragEnter">
    <Window.DataContext>
        <vm:OverlayViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootRing" Width="400" Height="400" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.84" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.84" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Сектора -->
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.32" Color="Black"/>
                </ItemsControl.Effect>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform CenterX="200" CenterY="200" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Panel.ZIndex" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="10"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.05" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.05" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Слой 1: размытый фон («стекло») -->
                            <Path Data="{Binding Shape}" RenderOptions.BitmapScalingMode="HighQuality">
                                <Path.Fill>
                                    <ImageBrush ImageSource="{Binding Glass}" ViewportUnits="Absolute"
                                                Viewport="0,0,400,400" Stretch="Fill"/>
                                </Path.Fill>
                            </Path>

                            <!-- Слой 2: тонировка (плавное изменение при наведении, у «Удалить» красная) -->
                            <Path Data="{Binding Shape}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource Glass.Tint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Glass.TintHover}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                <Setter Property="Fill" Value="#80D13438"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDanger}" Value="True"/>
                                                    <Condition Binding="{Binding IsHovered}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="#D8D13438"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Слой 3: тонкая кромка (при наведении акцентная и толще) -->
                            <Path Data="{Binding Shape}" IsHitTestVisible="False">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource Glass.Rim}"/>
                                        <Setter Property="StrokeThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Glass.RimHover}"/>
                                                <Setter Property="StrokeThickness" Value="2"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDanger}" Value="True"/>
                                                    <Condition Binding="{Binding IsHovered}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Stroke" Value="#FFFF6B6B"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Иконка + подпись -->
                            <Canvas IsHitTestVisible="False">
                                <Border Canvas.Left="{Binding TextX}" Canvas.Top="{Binding TextY}" Width="100" Height="64">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-50" Y="-32"/>
                                    </Border.RenderTransform>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="28" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Glass.Text}"/>
                                        <TextBlock Text="{Binding Title}" Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="84"
                                                   Foreground="{DynamicResource Glass.Text}"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Центр: иконка файла + счётчик / выбранное действие -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,4">
                <Grid HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding FileIcon}" FontSize="56" Foreground="White" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoFileImage, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.9" Color="Black"/>
                        </ui:SymbolIcon.Effect>
                    </ui:SymbolIcon>
                    <Image Source="{Binding FileImage}" Width="56" Height="56"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="{Binding HasFileImage, Converter={StaticResource BoolToVis}}">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                        </Image.Effect>
                    </Image>
                </Grid>

                <TextBlock Text="{Binding CountText}" FontSize="18" FontWeight="Bold" Foreground="White"
                        HorizontalAlignment="Center" Margin="0,1,0,0"
                        Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="{Binding CenterText}" FontSize="11" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" MaxWidth="90" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
